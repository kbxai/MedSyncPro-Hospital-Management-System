# Docker Compose deployment settings.
# Copy this file to .env in the repository root and replace every placeholder.
# Never commit .env or real credentials.

POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password

# Use the public HTTPS origin after a domain and TLS are configured.
FRONTEND_URL=http://YOUR_SERVER_IP
CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_DEFAULT_SENDER=no-reply@example.com
